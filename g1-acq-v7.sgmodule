#!name=G1 ACQ
#!desc=v7.3.0：记录订阅请求 URL（诊断用）；网页别名探测；支持 /u/N/ 多账号路径；附本地报告
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/(?:u\/\d+\/)?ai\?,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/GuangYiDing/g1-acq@v7.3.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/GuangYiDing/g1-acq@v7.3.0/g1-sku-report.js
g1-url-log = type=http-request,pattern=^https:\/\/one\.google\.com\/,requires-body=0,max-size=0,script-path=https://cdn.jsdelivr.net/gh/GuangYiDing/g1-acq@v7.3.0/g1-url-log.js

[MITM]
hostname = %APPEND% one.google.com
