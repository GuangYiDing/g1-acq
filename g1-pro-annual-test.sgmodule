#!name=G1 Pro Annual Test
#!desc=兼容入口，引用 G1 ACQ 同一三档脚本；当前主模块为 g1-acq-v7.sgmodule，启用一个即可
#!system=ios

[Rule]
# 与旧模块相同：拦截 UDP 443，作用于使用该配置的流量。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-pro-annual-test = type=http-response,pattern=^https:\/\/one\.google\.com\/(?:u\/\d+\/)?ai\?,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/GuangYiDing/g1-acq@v7.1.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/GuangYiDing/g1-acq@v7.1.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
